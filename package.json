{
  "name": "specgit-obsidian",
  "version": "0.3.7",
  "private": true,
  "description": "Edit notes live, auto-sync your vault, comment inline, and review or publish to GitHub without thinking about Git. Use specgit on desktop or phone, solo or with a team.",
  "license": "MIT",
  "author": "FnFirst",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hocuspocus/provider": "4.7.1",
    "preact": "10.29.8",
    "y-protocols": "1.0.7",
    "yjs": "13.6.31"
  },
  "devDependencies": {
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@eslint/js": "9.39.5",
    "@eslint/json": "0.14.0",
    "@types/node": "22.20.0",
    "esbuild": "0.28.1",
    "eslint": "9.39.5",
    "eslint-plugin-obsidianmd": "0.6.0",
    "jsdom": "29.1.1",
    "obsidian": "1.14.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "4.1.10"
  }
}
